NODE_ENV=development
PORT=3001

# Single source of truth for the displayed app / bank name (backend).
APP_NAME=State Bank

# App runtime connection. On Neon use the POOLED endpoint (-pooler host).
DATABASE_URL=postgresql://bank:bank@localhost:5432/bank_demo?schema=public
# Unpooled connection used by `prisma migrate` (schema.prisma directUrl).
# Locally this is the same URL; on Neon use the direct (non -pooler) host.
DIRECT_URL=postgresql://bank:bank@localhost:5432/bank_demo?schema=public
REDIS_URL=redis://localhost:6379

# RS256 keypair — base64-encoded PEM
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_MFA_TTL=5m
JWT_RECOVERY_TTL=15m

# Idle-session timeout — session revoked after this long with no authenticated
# activity (independent of the 30d refresh cap and the client-side app lock).
SESSION_IDLE_TIMEOUT=15m

# AES-256-GCM key, base64 (32 bytes) — used for SSN at rest
AES_KEY=

# Pepper for HMAC-SHA256 SSN hash (dup-detect)
SSN_PEPPER=

CORS_ORIGIN=http://localhost:3000
WEB_BASE_URL=http://localhost:3000

# SMTP — nodemailer. Leave SMTP_HOST blank to disable sending (logs only).
# For mailhog local catcher: SMTP_HOST=localhost / SMTP_PORT=1025.
# For Gmail: smtp.gmail.com / 587 / app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=                            # true | false — defaults to true on port 465
SMTP_FROM=no-reply@nova.demo

# Admin notifications (A.3.2 / A.4.7)
ADMIN_NOTIFICATION_EMAIL=ops@nova.demo
ADMIN_KYC_REVIEW_EMAIL=kyc@nova.demo
ADMIN_NOTIFICATION_ENABLED=true
WELCOME_EMAIL_ENABLED=true

# GeoIP — path to MaxMind GeoLite2 City mmdb
GEOIP_MMDB_PATH=./tooling/geoip/GeoLite2-City.mmdb

# MFA (Stage 1)
MFA_CODE_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=5

# Signup verification (Stage 2 / A.4)
VERIFICATION_CODE_TTL_SEC=600
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SEC=60
SIGNUP_SESSION_TTL_DAYS=7

# Object storage
STORAGE_DRIVER=filesystem            # filesystem | s3
STORAGE_FS_ROOT=./tooling/storage    # local dev
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=                 # MinIO etc.
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true

# Document upload constraints
DOC_MAX_BYTES=10485760               # 10 MB per file
ADMIN_ATTACHMENT_MAX_BYTES=20971520  # 20 MB combined

# Greeting (A.5)
WEATHER_PROVIDER=open-meteo          # open-meteo | openweather
OPENWEATHER_API_KEY=
GEOIP_FALLBACK_TIMEZONE=America/New_York
GREETING_CACHE_TTL_SEC=60
WEATHER_CACHE_TTL_SEC=600

# Account defaults (Stage 3)
CHECKING_DAILY_ATM_CENTS=50000
CHECKING_DAILY_PURCHASES_CENTS=500000
CHECKING_CASH_DEPOSIT_CENTS=200000
CHECKING_MOBILE_CHECK_CENTS=200000
CHECKING_OUTGOING_WIRE_CENTS=2500000
SAVINGS_APY_BPS=450

# Stage 4
TX_PAGE_DEFAULT=25
TX_PAGE_MAX=100
INSIGHTS_CACHE_TTL_SEC=300

# Stage 5 — transfers / workers
TRANSFER_MIN_CENTS=500
TRANSFER_MAX_CENTS=2500000
TRANSFER_INSTANT_FEE_BPS=175           # 1.75%
TRANSFER_INSTANT_FEE_MIN_CENTS=25
TRANSFER_SETTLE_INSTANT_MS=5000
TRANSFER_SETTLE_STANDARD_MS=30000
RECURRING_SCAN_CRON=0 * * * *           # hourly
TRIAL_BALANCE_CRON=0 3 * * *            # daily at 03:00 UTC
BULL_QUEUE_PREFIX=bank-demo
ADMIN_NOTIFY_TRANSFER_MIN_CENTS=0
ADMIN_NOTIFY_TRANSFER_BURST_WINDOW_SEC=60

# Stage 6 — pay
PAYMENT_REQUEST_TTL_DAYS=14

# Stage 7 — cards / elevation
JWT_ELEVATION_TTL=5m
CARD_REVEAL_TTL_SEC=30
CARD_DEMO_BIN=499999                    # clearly fake BIN
CARD_DEFAULT_SPENDING_LIMIT_CENTS=500000

# Stage 8 — savings / round-ups
ROUNDUP_DAILY_CRON=0 4 * * *
AUTOSAVE_WEEKLY_CRON=0 8 * * *

# Stage 11 — notification + provider config
# Email uses nodemailer; see SMTP_* above.

SMS_PROVIDER=stub                       # stub | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

NOTIFICATION_TX_LARGE_THRESHOLD_CENTS=10000

# Stage 12 — profile, 2FA, WebAuthn
AVATAR_MAX_BYTES=5242880               # 5 MB
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=State Bank
WEBAUTHN_ORIGIN=http://localhost:3000
TOTP_ISSUER=State Bank

# Stage 13 — documents + referrals
STATEMENT_MONTHLY_CRON=0 5 1 * *        # 1st of month, 05:00 UTC
REFERRAL_QUALIFY_BONUS_CENTS=2500
REFERRAL_CODE_LENGTH=8

# Stage 14 — admin
ADMIN_AUDIT_HMAC_KEY=                   # high-entropy string; signs each audit row
DEMO_OVERRIDE_MODE=true                 # set false to disable A.7 admin transaction overrides
OVERRIDE_RATE_LIMIT_PER_MIN=60

# ─── Admin Mail Desk (two-way threaded email over Resend) ────────────────
# Requires RESEND_API_KEY (above) + a verified Resend sending domain.
# All values below are OPTIONAL — defaults target the secure-access.site
# domain already used for RESEND_FROM.
#
# Inbound replies: enable Receiving on your domain in Resend, add the MX
# record it gives you (root secure-access.site is fine — it has no other MX),
# create an `email.received` webhook → https://<api-host>/api/v1/webhooks/resend/inbound,
# and paste its signing secret below. Without these, sending still works;
# replies just won't be captured.
RESEND_WEBHOOK_SECRET=                  # Svix signing secret from the Resend webhook
MAIL_REPLY_DOMAIN=secure-access.site
MAIL_DESK_CARE_FROM=care@secure-access.site
MAIL_DESK_CARE_NAME=State Bank — Customer Care
MAIL_DESK_ADMIN_FROM=admin@secure-access.site
MAIL_DESK_ADMIN_NAME=State Bank — Administration
MAIL_DESK_MANAGER_FROM=manager@secure-access.site
MAIL_DESK_MANAGER_NAME=State Bank — Office of the Manager
