{
  "name": "bank-demo-backend",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
