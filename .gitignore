# ─── Dependencies ──────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.pnpm-store/
.yarn/install-state.gz

# ─── Build output ──────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ─── Env / secrets (NEVER commit) ──────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.pub
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
secrets/
.secrets/

# Project-specific key material
apps/api/jwt_key
apps/api/jwt_key.*

# ─── Auth / session ────────────────────────────────────────────────────
.auth/
auth.json
cookies.txt

# ─── Database / storage / uploads ──────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.dump
*.sql
*.sql.gz
# Local DB dumps (real user data — never commit). Migration SQL lives under
# prisma/migrations and is force-allowed back in below.
!**/prisma/migrations/**/*.sql
# User-uploaded storage, anywhere in the tree (not just the repo root).
tooling/storage/*
!tooling/storage/.gitkeep
**/tooling/storage/*
!**/tooling/storage/.gitkeep
tooling/geoip/*.mmdb
uploads/
storage/local/

# ─── Test / coverage ───────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Caches ────────────────────────────────────────────────────────────
.cache/
.turbo/
.swc/
.eslintcache
.parcel-cache/

# ─── Logs ──────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Editor / IDE ──────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.history/
*.code-workspace
*.swp
*.swo

# ─── OS junk ───────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Local / personal scratch ──────────────────────────────────────────
*.local
*.local.*
TODO.local.md
NOTES.local.md
scratch/
tmp/
.tmp/

# ─── Tunnels / dev exposure ────────────────────────────────────────────
.cloudflared/
ngrok.yml
tunnel.yml
